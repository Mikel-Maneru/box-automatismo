{
  "redirects": [
    { "source": "/alt-1.html", "destination": "/", "permanent": true },
    { "source": "/alt-2.html", "destination": "/", "permanent": true },
    { "source": "/alt-3.html", "destination": "/", "permanent": true },
    { "source": "/index.legacy.html", "destination": "/", "permanent": true },
    { "source": "/reservar.legacy.html", "destination": "/", "permanent": true }
  ],
  "rewrites": [
    { "source": "/reservar", "destination": "/reservar.html" }
  ],
  "crons": [
    {
      "path": "/api/cron/followup",
      "schedule": "0 10 * * *"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        { "key": "X-Content-Type-Options", "value": "nosniff" },
        { "key": "X-Frame-Options", "value": "DENY" }
      ]
    }
  ]
}
