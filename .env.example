ANTHROPIC_API_KEY=sk-ant-...
SUPABASE_URL=https://xxx.supabase.co
SUPABASE_SERVICE_KEY=eyJ...
RESEND_API_KEY=re_xxxx
# Sin dominio verificado, usar onboarding@resend.dev como from
NOTIFY_EMAIL=anbotocf@gmail.com
# Remitente. Con onboarding@resend.dev Resend solo entrega al dueno de la cuenta.
# Verifica anbotosc.com en Resend y pon aqui algo como "Anboto SC <hola@anbotosc.com>".
MAIL_FROM=Anboto SC <onboarding@resend.dev>
# Correo de "elige tu dia" al interesado. "off" mientras la reserva la gestione
# el box a mano. NO afecta al aviso al box ni al correo de seguimiento.
EMAIL_ELEGIR_DIA=off
ALLOWED_ORIGIN=https://tu-dominio.vercel.app
# WodBuster
# Sistema de reservas del box: wodbuster | aimharder
BOOKING_PROVIDER=wodbuster

# Reserva automatica en WodBuster. Decision confirmada el 2026-09-01: se queda DESACTIVADA.
# Con la cuenta personal, cada clase de prueba queda reservada a nombre de esa persona, y
# eso paso con gente real. "on" solo cuando exista una cuenta del box.
# En Vercel esta variable NO existe a proposito: alli las variables son "Sensitive" y no se
# pueden releer, y una ausente se audita mejor que un valor oculto. Ausente = desactivada.
WODBUSTER_AUTOBOOK=off
WODBUSTER_BOX_URL=https://anboto.wodbuster.com
WODBUSTER_BOX_SLUG=anboto
WODBUSTER_SESSION_COOKIE=.WBAuth=...
WODBUSTER_USER_ID=24ff02e9981242aea680d74c98ee7f20
WODBUSTER_EMAIL=tu@email.com
WODBUSTER_PASSWORD=tu_password
# Cron
CRON_SECRET=...
# Base URL for scheduling links
BASE_URL=http://localhost:3003
# Para dev local:
PORT=3000