{
  "name": "box-automatismo",
  "version": "1.0.0",
  "description": "AI chat widget for CrossFit boxes",
  "main": "src/index.js",
  "scripts": {
    "start": "node src/index.js",
    "dev": "concurrently -n api,web -c blue,magenta \"nodemon src/index.js\" \"npm --prefix web run dev\"",
    "server:dev": "nodemon src/index.js",
    "web:dev": "npm --prefix web run dev",
    "web:install": "npm --prefix web install",
    "web:build": "npm --prefix web run build"
  },
  "engines": {
    "node": ">=20.0.0"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.39.0",
    "@supabase/supabase-js": "^2.49.1",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-rate-limit": "^8.4.1",
    "helmet": "^8.1.0",
    "ngrok": "^5.0.0-beta.2",
    "resend": "^6.12.2",
    "uuid": "^11.1.0"
  },
  "devDependencies": {
    "concurrently": "^9.1.2",
    "nodemon": "^3.1.9",
    "pg": "^8.20.0",
    "shadcn": "^4.18.0",
    "sharp": "^0.34.5"
  }
}
